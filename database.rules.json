{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "attendance": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "liveLocations": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    },
    "attendanceEvents": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    }
  }
}