{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": false
      }
    },
    "attendance": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": false
      }
    },
    "liveLocations": {
      "$uid": {
        ".read": "auth != null && auth.token.admin === true",
        ".write": false
      }
    },
    "attendanceEvents": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": false
    }
  }
}