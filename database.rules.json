{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'))",
        ".write": "auth != null && root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && ((!data.exists() && newData.child('role').val() === 'employee') || (data.exists() && newData.child('role').val() === data.child('role').val()))"
      }
    },
    "attendance": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'))",
        "$date": {
          ".write": "auth != null && auth.uid === $uid && root.child('profiles').child($uid).child('active').val() === true && root.child('profiles').child($uid).child('role').val() === 'employee' && ((!data.exists() && newData.child('checkInAt').exists() && !newData.child('checkOutAt').exists()) || (data.exists() && !data.child('checkOutAt').exists() && newData.child('checkInAt').val() === data.child('checkInAt').val() && newData.child('checkOutAt').exists()))"
        }
      }
    },
    "liveLocations": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && ( !newData.exists() || (root.child('profiles').child($uid).child('active').val() === true && root.child('profiles').child($uid).child('role').val() === 'employee' && root.child('attendance').child($uid).child(newData.child('attendanceDate').val()).exists() && !root.child('attendance').child($uid).child(newData.child('attendanceDate').val()).child('checkOutAt').exists()))"
      }
    },
    "attendanceEvents": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('active').val() === true && root.child('profiles').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    }
  }
}